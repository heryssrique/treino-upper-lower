<template>
  <div class="page" onclick="tap">
    <text class="title">{{title}}</text>
    <text class="ex">{{exName}}</text>
    <text class="sets">{{setTxt}}</text>
    <text class="clock" if="{{resting}}">{{clock}}</text>
    <text class="hint">{{hint}}</text>
  </div>
</template>

<script>
import storage from "@system.storage"
import vibrator from "@system.vibrator"
import plan from "../../common/plan.js"
import { pickDay, advance } from "../../common/logic.js"

// Progresso do dia fica no relógio: fechar o app no meio do treino não perde a série.
const KEY = "prog"
const today = () => { const d = new Date(); return d.getFullYear() + "-" + (d.getMonth() + 1) + "-" + d.getDate() }
const fmt = s => Math.floor(s / 60) + ":" + (s % 60 < 10 ? "0" : "") + (s % 60)

export default {
  private: {
    title: "", exName: "", setTxt: "", clock: "", hint: "", resting: false,
    wid: null, ex: 0, set: 0, end: 0, timer: 0
  },

  onInit() {
    this.wid = pickDay(plan.week, (new Date().getDay() + 6) % 7)
    storage.get({
      key: KEY,
      success: v => {
        try { const p = JSON.parse(v); if (p.d === today() && p.w === this.wid) { this.ex = p.ex; this.set = p.set } } catch (e) {}
        this.render()
      },
      fail: () => this.render()
    })
  },
  onDestroy() { clearInterval(this.timer) },

  render() {
    const W = plan.workouts[this.wid], x = W.ex[this.ex]
    this.title = W.name
    if (!x) { this.exName = "Treino concluído"; this.setTxt = ""; this.hint = "Salve as cargas no celular"; return }
    this.exName = x.n
    this.setTxt = "Série " + (this.set + 1) + "/" + x.s
    this.hint = this.resting ? "Toque para pular o descanso" : "Toque ao terminar a série"
  },

  tap() {
    if (this.resting) return this.stopRest()
    const r = advance({ ex: this.ex, set: this.set }, plan.workouts[this.wid].ex)
    this.ex = r.pos.ex; this.set = r.pos.set
    storage.set({ key: KEY, value: JSON.stringify({ w: this.wid, d: today(), ex: this.ex, set: this.set }) })
    vibrator.vibrate({ mode: "short" })
    if (r.rest) this.startRest(r.rest)
    this.render()
  },

  startRest(sec) {
    this.end = Date.now() + sec * 1000; this.resting = true; this.clock = fmt(sec)
    clearInterval(this.timer)
    this.timer = setInterval(() => {
      const left = Math.round((this.end - Date.now()) / 1000)
      if (left > 0) { this.clock = fmt(left); return }
      vibrator.vibrate({ mode: "long" })
      this.stopRest()
    }, 1000)
  },
  stopRest() { clearInterval(this.timer); this.resting = false; this.render() }
}
</script>

<style>
.page {
  width: 390px;
  height: 450px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}
.title { font-size: 26px; color: #808a86; }
.ex { width: 340px; font-size: 36px; color: #edf0ec; text-align: center; margin-top: 8px; }
.sets { font-size: 32px; color: #ee5a4e; margin-top: 8px; }
.clock { font-size: 80px; color: #edf0ec; margin-top: 6px; }
.hint { font-size: 22px; color: #808a86; margin-top: 12px; }
</style>
