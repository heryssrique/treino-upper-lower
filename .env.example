# Copie para .env (uso local) e configure as mesmas variáveis na Vercel.

# String de conexão do MongoDB Atlas (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nome do banco (opcional, padrão: treino)
MONGODB_DB=treino

# Sua chave pessoal: mínimo 16 caracteres. É a que você digita no app.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_KEY=
